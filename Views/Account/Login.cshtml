@{
    Layout = null;
}
@model LostAndFound.Models.AdminAccount
<head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@200..900&display=swap" rel="stylesheet">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Nunito, sans-serif;
        background-image: url('/images/abstract-bg-5.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        animation: fadein 1.5s ease forwards;
        opacity: 0;
    }

    @@keyframes fadein {
        to {
            opacity: 1;
        }
    }

    .login-container {
        width: 100%;
        max-width: 400px;
        padding: 35px;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        text-align: center;
    }

    h2 {
        margin-bottom: 20px;
        color: #333;
        font-size: 2rem;
    }

    .form-group {
        margin-bottom: 15px;
        text-align: left;
    }

    .login-input {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #ddd;
        font-family: Nunito, sans-serif;
        font-size: 1rem;
        transition: 0.2s ease;
    }

        .login-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 8px rgba(102,126,234,0.3);
        }

    .login-btn {
        width: 100%;
        padding: 12px;
        background: #667eea;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 10px;
        transition: transform 0.2s, box-shadow 0.2s;
        font-family: Nunito, sans-serif;
    }

        .login-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(102,126,234,0.4);
        }

    .error-message {
        color: #dc3545;
        margin-top: 10px;
        font-size: 0.9rem;
    }

    .back-btn {
        margin-top: 15px;
        display: inline-block;
        background: white;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: transform 0.2s, box-shadow 0.2s;
        font-family: Nunito, sans-serif;
    }

        .back-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .create-account-btn {
        width: 100%;
        padding: 12px;
        background: #667eea;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 10px;
        transition: transform 0.2s, box-shadow 0.2s;
        font-family: Nunito, sans-serif;
    }

            .create-account-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 6px 20px rgba(102,126,234,0.4);
            }

    @@media (max-width: 600px) {
        body {
            background-image: url('/images/abstract-mobile-bg-1.png');
        }

        .login-container {
            padding: 25px;
        }
    }
</style>
</head>

<div class="login-container">
    <h2>Admin Login</h2>

    <form asp-controller="Account" asp-action="Login" method="post">

        <div class="form-group">
            <input type="text" name="username" class="login-input" placeholder="Username" required />
        </div>

        <div class="form-group">
            <input type="password" name="password" class="login-input" placeholder="Password" required />
        </div>

        <button type="submit" class="login-btn">Login</button>
        <button type="button" class="create-account-btn" onclick="redirectToCreateAccount()">Create Admin Account</button>
        @if (ViewBag.Error != null)
        {
            <p class="error-message">@ViewBag.Error</p>
        }
    </form>

    <div class="back-btn" onclick="window.location.href='/'">
        ← Back to Home
    </div>
</div>

<script>
    function redirectToCreateAccount() {
        window.location.href = "@Url.Action("Register", "Account")";
    }
</script>